APP_NAME=WebScope Audit
DEBUG=false
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://webscope:webscope@postgres:5432/webscope
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MAX_SCAN_DEPTH=2
MAX_URLS_PER_SCAN=100
MAX_DOWNLOAD_SIZE_BYTES=2000000
TIMEOUT_SECONDS=10
