APP_NAME=WebScope Audit & Defense
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://webscope:CHANGE_ME@postgres:5432/webscope
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MAX_SCAN_DEPTH=1
MAX_URLS_PER_SCAN=40
MAX_DOWNLOAD_SIZE_BYTES=25000000
TIMEOUT_SECONDS=8
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
WEBSCOPE_ANALYST_API_KEY=
WEBSCOPE_PSEUDONYMIZATION_KEY=
WEBSCOPE_AUDIT_HMAC_KEY=
WEBSCOPE_AUDIT_LOG_PATH=/data/audit-chain.jsonl
