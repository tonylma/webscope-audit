# Historical backend-local sample. Prefer the root .env.example at repository root.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://webscope:REPLACE_DB_PASSWORD@postgres:5432/webscope
CORS_ORIGINS=http://localhost:5173
WEBSCOPE_JWT_SECRET=REPLACE_WITH_32_RANDOM_BYTES
WEBSCOPE_AUDIT_HMAC_KEY=REPLACE_WITH_32_RANDOM_BYTES
WEBSCOPE_PSEUDONYMIZATION_KEY=REPLACE_WITH_32_RANDOM_BYTES
WEBSCOPE_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY
WEBSCOPE_AUDIT_LOG_PATH=/data/audit-chain.jsonl
WEBSCOPE_BOOTSTRAP_ADMIN_USERNAME=admin
WEBSCOPE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_18_OR_MORE_RANDOM_CHARACTERS
ACCESS_TOKEN_MINUTES=20
