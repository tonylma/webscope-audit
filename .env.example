# Configuration locale WebScope Audit & Defense
# Copier vers .env à la racine. Ne jamais committer .env.
ENVIRONMENT=development
DEBUG=false
APP_NAME=WebScope Audit & Defense

# Pour POSTGRES_PASSWORD, utiliser un secret hexadécimal (sans caractères réservés URI).
POSTGRES_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
DATABASE_URL=postgresql+psycopg://webscope:REPLACE_WITH_48_HEX_CHARACTERS@postgres:5432/webscope

# CORS : origines exactes, séparées par des virgules. Jamais de joker *.
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
MAX_URLS_PER_SCAN=40
MAX_DOWNLOAD_SIZE_BYTES=25000000
TIMEOUT_SECONDS=8
ACCESS_TOKEN_MINUTES=20
WEBSCOPE_JWT_ISSUER=webscope-audit
WEBSCOPE_JWT_AUDIENCE=webscope-api

# Générer indépendamment chaque secret avec un CSPRNG (ex. openssl rand -hex 32).
WEBSCOPE_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
WEBSCOPE_AUDIT_HMAC_KEY=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
WEBSCOPE_PSEUDONYMIZATION_KEY=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
# Base64url sans padding de 32 octets aléatoires (AES-256-GCM).
WEBSCOPE_DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY
WEBSCOPE_AUDIT_LOG_PATH=/data/audit-chain.jsonl

# Création du premier administrateur uniquement lors du premier démarrage sans utilisateurs.
WEBSCOPE_BOOTSTRAP_ADMIN_USERNAME=admin
WEBSCOPE_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD_OF_18_CHARS_OR_MORE
WEBSCOPE_BOOTSTRAP_ADMIN_DISPLAY_NAME=WebScope Administrator

# Analyse antivirus des fichiers téléversés. ClamAV est isolé dans le réseau Docker privé.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_MAX_BYTES=25000000
